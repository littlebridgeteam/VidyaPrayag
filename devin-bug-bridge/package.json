{
  "name": "devin-bug-bridge",
  "version": "1.0.0",
  "description": "Bridge that batches Slack bug reports and sends them to Devin Kimi on the same branch",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create devin-bug-bridge-db",
    "db:migrate": "wrangler d1 migrations apply devin-bug-bridge-db"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
