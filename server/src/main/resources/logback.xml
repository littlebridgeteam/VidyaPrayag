<configuration>
    <!--
      Structured JSON logging (GAP-011).
      In production, logs are emitted as JSON for log aggregation (Datadog,
      Loki, CloudWatch, etc.). In dev, a human-readable pattern is used.

      Control via LOG_FORMAT env var:
        LOG_FORMAT=json  → JSON output (production default)
        LOG_FORMAT=text  → human-readable (dev default)
    -->

    <if condition='property("LOG_FORMAT").equalsIgnoreCase("json") || property("LOG_ENV").equalsIgnoreCase("production")'>
        <then>
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <includeContext>false</includeContext>
                    <includeMdc>true</includeMdc>
                    <customFields>{"app":"vidyaprayag","service":"server"}</customFields>
                    <fieldNames>
                        <timestamp>@timestamp</timestamp>
                        <levelValue>[ignore]</levelValue>
                    </fieldNames>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </else>
    </if>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Always keep noisy infrastructure loggers quiet regardless of LOG_LEVEL. -->
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <!-- Ktor's routing tracer is TRACE-only; pin it to INFO so a global
         LOG_LEVEL=DEBUG doesn't bring back the per-request route dump. -->
    <logger name="io.ktor.server.routing.Routing" level="INFO"/>
    <logger name="io.ktor.server.plugins.cors.CORS" level="INFO"/>
</configuration>
